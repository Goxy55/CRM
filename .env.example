# Kopirajte u .env i popunite. Nikada ne upisujte .env u Git.

# PostgreSQL 14+. Nalog ne sme biti superuser niti imati BYPASSRLS,
# inače izolacija organizacija (RLS) ne važi i aplikacija odbija start.
DATABASE_URL=postgresql://crm:LOZINKA@localhost:5432/crm
# DATABASE_SSL=true

# Javna adresa aplikacije, bez putanje i završne kose crte. U produkciji HTTPS.
APP_URL=http://localhost:3000

# Tajna za sesije: openssl rand -hex 32
BETTER_AUTH_SECRET=

# Ključevi za JMBG (svaki: openssl rand -hex 32, ili druga nasumična vrednost od 32+ znaka). Čuvati odvojeno od baze i
# njenih rezervnih kopija; bez njih se upisani JMBG ne može pročitati.
JMBG_ENCRYPTION_KEY=
JMBG_INDEX_KEY=

# Slanje pozivnica i poruka za reset lozinke. Bez SMTP-a u razvoju poruke
# završavaju u .data/mail; u produkciji reset lozinke tada nije dostupan.
# SMTP_URL=smtps://korisnik:lozinka@smtp.example.com:465
# MAIL_FROM=crm@example.com

# Broj pouzdanih proxy-ja ispred aplikacije (0 = direktan pristup).
# TRUST_PROXY_HOPS=1
